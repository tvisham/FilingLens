# Copy to .env and fill in. Never commit .env.

# Required by SEC fair-access policy: an app name plus a real contact email.
SEC_USER_AGENT="FilingLens Your Name your.email@illinois.edu"

# "local" = embedded open-source PostgreSQL + pgvector in data/pgdata (`uv sync --extra localdb`),
# started automatically; no install or Docker. Or any Postgres with pgvector, e.g.
# postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="local"

# Optional overrides
CACHE_DIR=".cache/sec"
SEC_MAX_REQUESTS_PER_SECOND=8

# Phase 2+ (agent). Leave the key empty to use an existing Claude Code / `ant auth login` credential.
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-opus-5-5"
AGENT_EFFORT="medium"
AGENT_MAX_TURNS=12
AGENT_MAX_BUDGET_USD=1.0

# Phase 3: risk-factor classification (Claude API) and embeddings (local, `uv sync --extra embeddings`)
CLASSIFIER_MODEL="claude-opus-5-5"
CLASSIFIER_EFFORT="low"
CLASSIFIER_FACTORS_PER_REQUEST=8

# Phase 4: LLM judge for `filinglens eval run --suite full`
JUDGE_MODEL="claude-opus-5-5"
JUDGE_EFFORT="medium"

# Phase 6: web API. Required header for review decisions when set.
API_TOKEN=""

# Stock prices: free key from https://www.alphavantage.co/support/#api-key (25 requests/day)
ALPHAVANTAGE_API_KEY=""
